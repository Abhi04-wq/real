# Copy to .env and fill real values. Never commit .env.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/propestate
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SEED_ADMIN_EMAIL=superadmin@primenest.com
SEED_ADMIN_PASSWORD=SuperAdmin@123
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=you@example.com
SMTP_PASSWORD=your-app-password
FROM_NAME=PrimeNest Properties
FROM_EMAIL=noreply@example.com
# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
